shturm.aimuzov.online {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Временный адрес: в поиске должен остаться только cf-shturm.ru.
		X-Robots-Tag "noindex, nofollow"
	}

	reverse_proxy shturm-site:80

	log {
		output file /data/shturm.log {
			roll_size 5MiB
			roll_keep 2
		}
	}
}
