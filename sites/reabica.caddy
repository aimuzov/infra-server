# Требования к CRM Reabica, репо aimuzov/reabica, на сервере /srv/reabica.

# Лендинга пока нет, корень ведёт на требования. Редирект временный, чтобы браузеры
# не запомнили его, когда на корне появится свой сайт.
reabica.ru {
	redir https://docs.reabica.ru{uri}
}

docs.reabica.ru {
	import common

	# Сайт закрыт целиком. Без пароля открыты только robots.txt и /api/health: по ним
	# деплой проверяет выкладку. Логин и хеш берутся из .env на сервере (см. compose.yml).
	# /api/admin/* -- ручки CLI комментариев, их закрывает свой токен в самом API.
	@private not path /robots.txt /api/health /api/admin/*
	basic_auth @private {
		{$REABICA_AUTH_USER} {$REABICA_AUTH_HASH}
	}

	handle /api/* {
		reverse_proxy reabica-api:8787
	}

	handle {
		reverse_proxy reabica:80
	}
}
